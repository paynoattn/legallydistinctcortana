{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assistant",
  "version": "0.1.0",
  "identifier": "dev.localassistant.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Assistant",
        "visible": false,
        "width": 1100,
        "height": 720
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "index.html?view=settings",
        "create": false,
        "visible": false,
        "width": 560,
        "height": 720,
        "minWidth": 440,
        "minHeight": 480
      },
      {
        "label": "overlay",
        "title": "Indicator",
        "url": "index.html?view=overlay",
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "width": 160,
        "height": 160
      },
      {
        "label": "read-aloud",
        "title": "Read aloud",
        "url": "index.html?view=read-aloud",
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "width": 320,
        "height": 590
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
